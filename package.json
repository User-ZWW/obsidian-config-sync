{
  "name": "obsidian-config-sync",
  "version": "0.1.0",
  "description": "Obsidian plugin: mirror-sync the .obsidian config folder to Dropbox with zip snapshots and a safe restore path",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-reporter=spec \"test/**/*.test.mjs\"",
    "test:only": "node --test --test-reporter=spec \"test/**/*.test.mjs\"",
    "test:load": "npm run build && node --test --test-reporter=spec test/plugin-load.test.mjs",
    "smoke": "node scripts/smoke-dropbox.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.14.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  }
}
